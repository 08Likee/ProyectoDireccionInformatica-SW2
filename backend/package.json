{
  "name": "direccion-informatica-backend",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --silent --testPathIgnorePatterns=integracion",
    "test:integration": "jest --runInBand --runTestsByPath src/pk01-gestion-usuarios-seguridad/cuenta.integracion.spec.ts src/pk01-gestion-usuarios-seguridad/autorizaciones.integracion.spec.ts",
    "test:ci": "jest --runInBand",
    "lint": "eslint 'src/**/*.ts'"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
